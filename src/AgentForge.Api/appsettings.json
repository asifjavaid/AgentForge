{
  "AI": {
    "Provider": "OpenAI"
  },
  "OpenAI": {
    "Model": "gpt-4.1-mini",
    "TimeoutSeconds": 30
  },
  "AzureFoundry": {
    "DeploymentName": "agentforge-gpt5-mini",
    "TimeoutSeconds": 60
  },
  "Agent": {
    "MaxIterations": 10,
    "TimeoutSeconds": 120
  },
  "RepositoryAnalysis": {
    "AllowedRoot": "",
    "MaxFileBytes": 65536,
    "MaxListResults": 200,
    "MaxSearchResults": 50,
    "MaxSearchFiles": 2000,
    "MaxToolResultCharacters": 100000,
    "IgnoredDirectories": [
      ".git",
      "bin",
      "obj",
      "node_modules",
      "dist",
      "build"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
