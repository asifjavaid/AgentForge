{
  "AI": {
    "Provider": "AzureFoundry"
  },
  "OpenAI": {
    "Model": "gpt-4.1-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "TimeoutSeconds": 30
  },
  "AzureFoundry": {
    "Endpoint": "https://agentforge-dev-resource.services.ai.azure.com/api/projects/agentforge-dev",
    "DeploymentName": "agentforge-gpt5-mini",
    "EmbeddingDeploymentName": "text-embedding-3-small",
    "EmbeddingEndpoint": "https://agentforge-dev-resource.cognitiveservices.azure.com",
    "TimeoutSeconds": 60,
    "ToolCallingMaxRetries": 2
  },
  "Agent": {
    "MaxIterations": 10,
    "TimeoutSeconds": 120
  },
  "SoftwareAgent": {
    "RepositoryPath": ".",
    "MaxSteps": 8,
    "MaxToolCalls": 12,
    "MaxKnowledgeResults": 4,
    "MaxRepositorySearchResults": 12,
    "MaxRepositorySearchCalls": 3,
    "MaxTotalToolResultCharacters": 60000,
    "TimeoutSeconds": 180
  },
  "DurableAgent": {
    "StoreProvider": "File",
    "FilePath": "App_Data/agent-checkpoints",
    "LeaseSeconds": 120,
    "MaxCheckpointBytes": 524288,
    "MaxConversationMessages": 100
  },
  "AzureTableCheckpoint": {
    "Endpoint": "",
    "TableName": "AgentForgeAgentRuns",
    "TenantId": ""
  },
  "MultiAgentWorkflow": {
    "StoreProvider": "File",
    "FilePath": "App_Data/workflow-checkpoints",
    "LeaseSeconds": 300,
    "MaxPlannedTasks": 8,
    "MaxDependencyDepth": 6,
    "MaxConcurrency": 2,
    "MaxModelCallsPerSpecialist": 5,
    "MaxTotalModelCalls": 24,
    "MaxTotalToolCalls": 24,
    "MaxTotalTokens": 100000,
    "MaxTaskOutputCharacters": 40000,
    "MaxCheckpointBytes": 2000000,
    "MaxEvents": 200,
    "MaxRevisionCycles": 2,
    "MaxTaskAttempts": 8,
    "AttemptTimeoutSeconds": 300
  },
  "RepositoryAnalysis": {
    "AllowedRoot": "",
    "MaxFileBytes": 65536,
    "MaxListResults": 200,
    "MaxSearchResults": 50,
    "MaxSearchFiles": 2000,
    "MaxToolResultCharacters": 100000,
    "IgnoredDirectories": [
      ".git",
      ".vs",
      "bin",
      "obj",
      "node_modules",
      "dist",
      "build"
    ]
  },
  "Rag": {
    "CorpusPath": "knowledge",
    "Retriever": "AzureAiSearch",
    "ChunkSize": 900,
    "ChunkOverlap": 150,
    "TopK": 4,
    "MinimumSimilarity": 0.35,
    "MaxDocumentBytes": 131072,
    "EmbeddingBatchSize": 16
  },
  "AzureAiSearch": {
    "Endpoint": "https://agentforge-search-dev.search.windows.net",
    "IndexName": "agentforge-knowledge",
    "TenantId": "",
    "RetrievalMode": "SemanticHybrid",
    "TopK": 4
  },
  "Pricing": {
    "Currency": "USD",
    "Models": []
  },
  "HumanApproval": {
    "StoreProvider": "File",
    "FilePath": "AgentForge/approvals",
    "SandboxRoot": "AgentForge/action-sandbox",
    "EnvironmentName": "LocalSandbox",
    "PolicyVersion": "A10-v1",
    "ApprovalLifetimeMinutes": 30,
    "ExecutionLeaseSeconds": 30,
    "ExecutionTimeoutSeconds": 10,
    "MaxRecordBytes": 262144,
    "MaxAuditEvents": 100,
    "AllowedFlagNames": [ "enable-demo-feature" ]
  },
  "DevelopmentAuthentication": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
